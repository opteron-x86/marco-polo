set(output "${CMAKE_CURRENT_BINARY_DIR}/campaign-test-output")
file(REMOVE_RECURSE "${output}")
execute_process(COMMAND "${SIM}" "${DATA}/economy.json" "${DATA}/security.json" "${output}" 1 120
  RESULT_VARIABLE result OUTPUT_VARIABLE report ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Campaign simulation failed: ${report}${errors}")
endif()
file(READ "${output}/summary.json" summary)
string(JSON count LENGTH "${summary}" runs)
if(NOT count EQUAL 16)
  message(FATAL_ERROR "Missing world/player campaign scenarios")
endif()
foreach(i RANGE 0 15)
  string(JSON style GET "${summary}" runs ${i} player)
  string(JSON wallet GET "${summary}" runs ${i} player_totals gold)
  if((style STREQUAL observer OR style STREQUAL explorer) AND NOT wallet EQUAL 1000)
    message(FATAL_ERROR "Passive player gained or lost gold")
  endif()
  if(style STREQUAL trader)
    string(JSON bought GET "${summary}" runs ${i} player_totals bought)
    if(NOT bought GREATER 0)
      message(FATAL_ERROR "Trader failed to exercise transactions")
    endif()
  endif()
endforeach()
# These world histories are identical until the war ends on day 365.
foreach(i RANGE 0 3)
  math(EXPR later "${i} + 8")
  string(JSON before GET "${summary}" runs ${i} years)
  string(JSON after GET "${summary}" runs ${later} years)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Future peace changed an earlier campaign period")
  endif()
endforeach()
message(STATUS "${report}")
