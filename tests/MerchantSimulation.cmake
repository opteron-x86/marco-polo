# Small paired run in CI; the full balance experiment uses 32 seeds.
set(output "${CMAKE_CURRENT_BINARY_DIR}/merchant-test-output")
file(REMOVE_RECURSE "${output}")
execute_process(COMMAND "${SIM}" "${DATA}/economy.json" "${DATA}/security.json" "${output}" 2
  RESULT_VARIABLE result OUTPUT_VARIABLE report ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Merchant simulation failed: ${report}${errors}")
endif()
file(READ "${output}/summary.json" summary)
foreach(scenario unchanged all_raiders_cleared valtheim_cleared greymoor_imperial)
  foreach(journey drink:rift-pale weapons:whiterun-winterhold silver:reach-haafingar housewares:rift-winterhold)
    string(JSON profitable GET "${summary}" models shipped "${scenario}" trades "${journey}" profitable_seeds)
    if(NOT profitable EQUAL 2)
      message(FATAL_ERROR "Trade route lost profitability: ${scenario} / ${journey}")
    endif()
  endforeach()
endforeach()
foreach(metric mean_buy_one mean_stock)
  string(JSON unsafe GET "${summary}" models import_fixture unchanged shops destination:iron "${metric}")
  string(JSON safe GET "${summary}" models import_fixture all_raiders_cleared shops destination:iron "${metric}")
  if(metric STREQUAL mean_buy_one AND NOT safe LESS unsafe)
    message(FATAL_ERROR "Safer imports failed to lower the import-dependent shop quote")
  elseif(metric STREQUAL mean_stock AND NOT safe GREATER unsafe)
    message(FATAL_ERROR "Safer imports failed to improve the import-dependent shop stock")
  endif()
endforeach()
message(STATUS "${report}")
