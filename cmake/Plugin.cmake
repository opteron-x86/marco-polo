if(NOT WIN32)
  message(FATAL_ERROR "The SKSE DLL requires a Windows toolchain")
endif()
include(FetchContent)
set(ENABLE_SKYRIM_SE ON CACHE BOOL "" FORCE)
set(ENABLE_SKYRIM_AE ON CACHE BOOL "" FORCE)
set(ENABLE_SKYRIM_VR OFF CACHE BOOL "" FORCE)
set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(COMMONLIB_PREBUILT OFF CACHE BOOL "" FORCE)
set(COMMONLIB_ENABLE_IPO OFF CACHE BOOL "" FORCE)
FetchContent_Declare(CommonLibSSE GIT_REPOSITORY https://github.com/alandtse/CommonLibSSE-NG.git GIT_TAG 12d61f3c39f7d4ba1b1ab543df2bca0e613dc747 GIT_SUBMODULES extern/openvr EXCLUDE_FROM_ALL)
FetchContent_Declare(minhook GIT_REPOSITORY https://github.com/TsudaKageyu/minhook.git GIT_TAG c3fcafdc10146beb5919319d0683e44e3c30d537 EXCLUDE_FROM_ALL)
FetchContent_MakeAvailable(CommonLibSSE minhook)
foreach(property COMPILE_DEFINITIONS INTERFACE_COMPILE_DEFINITIONS)
  get_target_property(definitions CommonLibSSE ${property})
  list(FILTER definitions EXCLUDE REGEX "^(WINVER|_WIN32_WINNT)=")
  list(APPEND definitions WINVER=0x0A00 _WIN32_WINNT=0x0A00)
  set_property(TARGET CommonLibSSE PROPERTY ${property} "${definitions}")
endforeach()
add_library(MarcoPolo SHARED src/runtime/Plugin.cpp src/runtime/Runtime.cpp src/runtime/Barter.cpp src/runtime/Information.cpp)
target_link_libraries(MarcoPolo PRIVATE marco_core CommonLibSSE minhook)
target_include_directories(MarcoPolo PRIVATE third_party)
target_compile_definitions(MarcoPolo PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX UNICODE _UNICODE MARCO_VERSION="${PROJECT_VERSION}" MARCO_VERSION_MAJOR=${PROJECT_VERSION_MAJOR} MARCO_VERSION_MINOR=${PROJECT_VERSION_MINOR} MARCO_VERSION_PATCH=${PROJECT_VERSION_PATCH})
target_compile_options(MarcoPolo PRIVATE /EHsc /utf-8 /W4 /Zi)
target_link_options(MarcoPolo PRIVATE /DEBUG:FULL)
set_target_properties(MarcoPolo PROPERTIES PREFIX "")
